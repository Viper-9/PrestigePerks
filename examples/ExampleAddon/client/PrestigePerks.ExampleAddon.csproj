<Project Sdk="Microsoft.NET.Sdk">
  <!-- Example client add-on, for testing only and never released (only tools\deploy-dev.ps1 -Example copies it).
       References the PrestigePerks plugin DLL to use the public API PrestigePerks.Api.PerkAddons -->
  <PropertyGroup>
    <AssemblyName>PrestigePerks.ExampleAddon</AssemblyName>
    <RootNamespace>PrestigePerks.ExampleAddon</RootNamespace>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Managed>$(SptRoot)\EscapeFromTarkov_Data\Managed</Managed>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(SptRoot)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(SptRoot)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- PrestigePerks.Client.dll is already installed in the game, so it is not copied -->
    <ProjectReference Include="..\..\..\client\PrestigePerks.Client\PrestigePerks.Client.csproj" Private="false" />
  </ItemGroup>
  <Target Name="RequireSptRoot" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
    <Error Condition="'$(SptRoot)' == ''" Text="SptRoot is not set. Create PrestigePerks.local.props from PrestigePerks.local.props.example and set SptRoot." />
  </Target>
</Project>
