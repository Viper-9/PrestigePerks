<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>PrestigePerks</AssemblyName>
    <RootNamespace>PrestigePerks</RootNamespace>
    <OutputPath>bin\$(Configuration)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Dev: 테스트용 빌드. Release 와 같게 최적화하고 개발용 Commando 명령(prestige ...)만 더 넣는다.
       Release(상용 배포)에는 명령 코드가 아예 들어가지 않는다. tools\deploy-dev.ps1 과 package.ps1 -Dev 가 쓴다 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Dev'">
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);DEV_COMMANDS</DefineConstants>
  </PropertyGroup>

  <!-- 베타 배포용 임시 규칙 (Perks\PerkBeta.cs): 슬롯 6개, 리롤 무제한. dotnet build -p:Beta=true (package.ps1 -Beta, deploy-dev.ps1 -Beta) -->
  <PropertyGroup Condition="'$(Beta)' == 'true'">
    <DefineConstants>$(DefineConstants);BETA</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTushonka.Common" Version="4.1.5" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.5" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.5" />
  </ItemGroup>

  <!-- 17번 장인 서버 패치. SPT 런타임에 있는 Harmony 를 그대로 쓴다 (복사하지 않음) -->
  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(SptRoot)\SPT_Runtime\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Data\** 는 SDK 기본 글롭으로 이미 None 항목이므로 Include 가 아니라 Update 로 복사 속성만 붙인다 (중복 항목 오류 방지) -->
    <None Update="Data\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- 프레스티지 코인 번들. bundles.json 은 번들이 있을 때만 내보낸다 (없으면 SPT가 "Could not find bundle" 오류를 낸다) -->
    <None Update="bundles\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove="bundles.json" />
    <None Remove="bundles.json" />
    <None Include="bundles.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('bundles\prestige_coin.bundle')" />
    <!-- 설정 파일. Web SDK 가 *.json 을 Content 로 잡으므로 빼고 None 으로 복사한다 -->
    <Content Remove="config\**" />
    <None Remove="config\**" />
    <None Include="config\**" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="PrestigePerks.Tests" />
  </ItemGroup>

</Project>
