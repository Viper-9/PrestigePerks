<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\server\PrestigePerks.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- 클라이언트의 게임 의존 없는 모델(응답 파싱, 화면 상태, 문구)만 가져와 검증한다. 게임 DLL 없이 돈다 -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Compile Include="..\..\client\PrestigePerks.Client\Model\*.cs" Link="ClientModel\%(Filename)%(Extension)" />
    <None Include="..\..\client\PrestigePerks.Client\Locales\*.json" Link="ClientLocales\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\client\PrestigePerks.Client\Assets\Icons\*.png" Link="ClientIcons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 예제 add-on 데이터 (examples/ExampleAddon/perks) 가 서버 검사를 통과하는지 본다 -->
  <ItemGroup>
    <None Include="..\..\examples\ExampleAddon\perks\**\*" LinkBase="ExampleAddon\example" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
